{
  "name": "@rollercoders/flagforge-react",
  "version": "0.1.2",
  "description": "React client library for FlagForge feature flags",
  "license": "MIT",
  "author": "Rollercoders",
  "homepage": "https://github.com/Rollercoders/flagforge-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rollercoders/flagforge-react.git"
  },
  "bugs": {
    "url": "https://github.com/Rollercoders/flagforge-react/issues"
  },
  "keywords": [
    "flagforge",
    "feature-flags",
    "feature-toggles",
    "react",
    "react-hooks"
  ],
  "main": "./dist/flagforge-react.umd.cjs",
  "module": "./dist/flagforge-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flagforge-react.js",
      "require": "./dist/flagforge-react.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "yarn test && yarn build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "type": "module",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "examples/*"
  ],
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.5.0"
  }
}
